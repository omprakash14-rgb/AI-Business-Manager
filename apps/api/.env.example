# ==========================================
# Fastify Backend Server Configuration
# ==========================================
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:5174,http://localhost:5173,http://localhost:5175,http://localhost:3000

# Session Cookie Signing Secret (minimum 32 random characters in production)
COOKIE_SECRET=replace-with-a-secure-random-32-character-secret

# ==========================================
# Supabase Managed PostgreSQL Configuration
# ==========================================
# How to obtain from Supabase:
# 1. Log in to your Supabase project (https://supabase.com/dashboard).
# 2. Navigate to Project Settings -> Database.
# 3. Under "Connection string", select the "URI" tab.
#
# A. DATABASE_URL (Transaction Pooler - Port 6543):
#    Use the "Transaction" pooler connection string for backend application runtime queries.
#    Transaction mode uses Supavisor / PgBouncer connection pooling to efficiently manage concurrent queries.
#    Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# B. DIRECT_URL (Session Mode / Direct - Port 5432):
#    Use the "Session" mode direct connection string for running Drizzle Kit schema migrations.
#    DDL operations (creating tables, indexes, constraints) require a direct session connection.
#    Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional Supabase Project Metadata (Server-side only — never expose to frontend clients):
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
